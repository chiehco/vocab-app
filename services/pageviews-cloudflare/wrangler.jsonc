{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocab-pageviews",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "PAGEVIEWS", "class_name": "PageViewCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PageViewCounter"] }
  ]
}
