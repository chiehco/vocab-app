        1024,
        1024
      ],
      "sha256": "16327d8d9b89bdcbf25b630742a8cc5ffb0ab693e5b4ec39438a81eead63bc34",
      "actualHeroExcerpt": "The Doudous work together to care for the forest and stream environment.\n\n豆豆們一起照顧森林與溪流環境。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V004",
      "word": "highly",
      "path": "public/wordbeast/audited-20261105/LV1-U15-89-406daf019233.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "a3dc351c923a1bfb90ce1e833923b678bf607e8f2b98d10ed83492d2cc98c152",
      "actualHeroExcerpt": "My coach always speaks highly of my teammates' hard work and dedication.\n\n我的教練總是高度讚賞隊友們的努力與付出。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V005",
      "word": "blank",
      "path": "public/wordbeast/a/W001099.webp",
      "dimensions": [
        1024,
        1024
      ],
      "sha256": "82c6a95a64133597dfc4d63535075357f54482d5c09a22fcd079b4fba6ecbe5b",
      "actualHeroExcerpt": "Doudou holds up a blank sheet of paper with no marks on it.\n\n豆豆舉著一張完全沒有任何記號的空白紙。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V006",
      "word": "material",
      "path": "public/wordbeast/a/W001535.webp",
      "dimensions": [
        1024,
        1024
      ],
      "sha256": "d09b13c793ed74cc0e0a1ccf21b77a1d393003e358225121768c08d88fb4de69",
      "actualHeroExcerpt": "Wood, cloth, clay, and metal are laid out as materials on the table.\n\n桌上擺著木材、布料、黏土和金屬。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V007",
      "word": "include",
      "path": "public/wordbeast/lv1-reviewed/LV1-U10-40-ed25ef9eb104.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "90119e86bd6369ccfb9d272900688f0cd8a08a5a00eb59a6ffe8f899fc7164e3",
      "actualHeroExcerpt": "Make sure the folder includes all the pages of your report.\n\n請確認資料夾包含你報告的所有頁面。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V008",
      "word": "record",
      "path": "public/wordbeast/lv1-reviewed/LV1-U23-28-52800551f982.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "fcfd7d54c6525e95a36f182c03c5e5c488ba51c9b30781cfebc38283213cf407",
      "actualHeroExcerpt": "He recorded the TV show for a friend who would not be home.\n\n他幫不在家的朋友錄下電視節目。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V010",
      "word": "usual",
      "path": "public/wordbeast/lv1-reviewed/LV1-U09-18-cb29dff77f69.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "4ca009e02514d6f220edfd41e367355250d66a7cc46adb7338f3984628c65a04",
      "actualHeroExcerpt": "As usual, he has cereal and coffee for breakfast.\n\n和平常一樣，他早餐吃麥片配咖啡。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V011",
      "word": "therefore",
      "path": "public/wordbeast/a/W001901.webp",
      "dimensions": [
        1024,
        1024
      ],
      "sha256": "cae5b7071718d7b68fa536bfbbda7cedf2627c1682d242714e22ad1784caefac",
      "actualHeroExcerpt": "There is standing water outside; therefore, Doudou puts on rain boots before leaving.\n\n外面有積水，因此豆豆先穿上雨靴再出門。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V025",
      "word": "personal",
      "path": "public/wordbeast/lv1-reviewed/LV1-U08-06-2d8da17bc6c1.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "627505f508c0c2d8fafb6006ab7e6815ac6aef1c4e3bb7cd8ebea0c4985faf41",
      "actualHeroExcerpt": "He has a personal message for me, for you, and for everyone.\n\n他有一段私人的話要對我、對你、對大家說。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V026",
      "word": "personality",
      "path": "public/wordbeast/audited-20261105/LV1-U08-07-40212bad0afa.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "314cb81f0d885ac50654c2659680bbbe01a6a2d92db0ee131cffbb05b26e588e",
      "actualHeroExcerpt": "The talk show invited a famous TV personality to share his life stories.\n\n那個談話節目邀請了一位知名電視名人分享他的人生故事。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V027",
      "word": "private",
      "path": "public/wordbeast/audited-20261105/LV1-U08-49-ac855aecf642.webp",
      "dimensions": [
        1254,
        1254
      ],
      "sha256": "90318d46a7c6401346662be1d37e24df28af4ee6131456aa763b6c4d987e5682",
      "actualHeroExcerpt": "Can we talk in private? I don't want others to hear.\n\n我們可以私下談嗎？我不想讓別人聽到。",
      "pixelsActuallyViewed": true
    },
    {
      "id": "LI-LV2U28-V028",
      "word": "secret",
      "path": "public/wordbeast/lv1-reviewed/LV1-U22-68-6f98c3be405c.webp",
